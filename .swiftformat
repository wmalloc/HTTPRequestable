--exclude Pods,Package.swift,.build,**/.build,.swiftpm,**/.swiftpm,Carthage
--swiftversion 6.3
--binarygrouping none
--decimalgrouping none
--hexgrouping none
--ifdef no-indent
--octalgrouping none
--patternlet inline
--self init-only
--stripunusedargs closure-only
--tabwidth 2
--indent 2
--commas inline
--test-case-name-format preserve
--disable wrapMultilineStatementBraces
# rules
